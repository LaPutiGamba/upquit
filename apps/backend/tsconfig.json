{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
